# Docker Compose defaults for local development only.
POSTGRES_USER=user
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=collab_ide

# Docker Desktop commonly uses 0. On Linux, use the Docker socket group ID.
DOCKER_GID=0

# Generate two different random values (at least 32 characters each).
JWT_ACCESS_SECRET=replace-with-a-unique-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters

# Browser origin allowed by the backend.
CLIENT_URL=http://localhost
