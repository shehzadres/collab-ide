NODE_ENV=development
PORT=4000

# Host-side connection to the PostgreSQL service in docker/docker-compose.yml.
DATABASE_URL=postgresql://user:replace-with-a-local-database-password@localhost:55432/collab_ide?schema=public
REDIS_URL=redis://localhost:6379

# Generate unique, different values with at least 32 characters each for production.
JWT_ACCESS_SECRET=replace-with-a-unique-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

CLIENT_URL=http://localhost:5173
MAX_TERMINAL_SESSIONS=50
TERMINAL_IDLE_TIMEOUT_MS=600000

# Set true only for hosted environments where Docker execution is unavailable.
DEMO_MODE=false
