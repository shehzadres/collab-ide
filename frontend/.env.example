# Local development: Vite proxies API and WebSocket requests to localhost:4000.
# Keep these same-origin defaults so refresh-cookie behavior works correctly.
VITE_API_URL=/api
VITE_YJS_WS_URL=ws://localhost:5173
VITE_TERMINAL_WS_URL=ws://localhost:5173/terminal

# Hosted deployment example (replace with your backend origin):
# VITE_API_URL=https://api.example.com/api
# VITE_YJS_WS_URL=wss://api.example.com
# VITE_TERMINAL_WS_URL=wss://api.example.com/terminal

# Set true when the backend is also configured with DEMO_MODE=true.
# This hides Docker-dependent controls in the frontend.
VITE_DEMO_MODE=false
